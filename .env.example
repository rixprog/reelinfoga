# Copy to .env and fill in.  .env is gitignored — never commit real keys.

# Transcription (https://console.groq.com/keys)
GROQ_API_KEY=

# ── Extraction ───────────────────────────────────────────────────────────────
# gemini (free tier) | claude
EXTRACTION_PROVIDER=gemini
GEMINI_API_KEY=                       # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.1-flash-lite

ANTHROPIC_API_KEY=                    # only if EXTRACTION_PROVIDER=claude
EXTRACTION_MODEL=claude-opus-5

# ── Instagram session ────────────────────────────────────────────────────────
# Needed for comments, geotags, and creator bios (where "link in bio"
# registration URLs live). Anonymous access to bios is now a login wall.
#
#   ./.venv/bin/python login.py --browser brave     # after signing in there
#   ./.venv/bin/python login.py --verify
#
# Use a throwaway account — automated fetching gets accounts action-blocked.
IG_USERNAME=
IG_SESSION_FILE=

# ── Notifications ────────────────────────────────────────────────────────────
# All optional. With none set, reminders print to the console.
#   ./.venv/bin/python reminders.py --test        # check your setup

# TELEGRAM — free, no approval, no domain. The recommended channel.
#   1. Message @BotFather on Telegram, send /newbot, copy the token.
#   2. Send any message to your new bot.
#   3. Open https://api.telegram.org/bot<TOKEN>/getUpdates and copy
#      result[0].message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# EMAIL — free over SMTP with any provider.
# Gmail: enable 2FA, then create an App Password at
# https://myaccount.google.com/apppasswords (your normal password will not work).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# WHATSAPP — pick ONE. Neither is as painless as Telegram.
#
# (a) CallMeBot: free, unofficial, sends only to your OWN number. Message
#     +34 644 51 95 23 with "I allow callmebot to send me messages" to get a key.
CALLMEBOT_PHONE=                      # e.g. +919876543210
CALLMEBOT_APIKEY=
#
# (b) Meta WhatsApp Cloud API: official, but needs a Business account, a
#     dedicated number, and PRE-APPROVED TEMPLATES for business-initiated
#     messages — which a deadline reminder is. Days of setup, not hackathon work.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TO=

# ── Tuning ───────────────────────────────────────────────────────────────────
MAX_COMMENTS=100
KEYFRAMES=6
# Media is purged after extraction (~18 MB/reel of video nothing downstream
# reads). Set to 1 only when debugging the extractor itself.
KEEP_MEDIA=
KEEP_THUMBNAIL=1
