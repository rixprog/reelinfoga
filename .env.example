# Copy to .env and fill in.  .env is gitignored — never commit real keys.

# Transcription (https://console.groq.com/keys)
GROQ_API_KEY=

# Structured extraction (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# ── Instagram session ────────────────────────────────────────────────────────
# REQUIRED for geotags and comments. Without a session:
#   · post.location returns None      (instaloader hard-requires login)
#   · comments 401 / rate-limit fast
#
# Log in ONCE from the CLI, which writes a reusable session file:
#     instaloader --login <your_username>
# then set the username here.  Use a throwaway account.
IG_USERNAME=
# Optional: explicit path to the session file (default = instaloader's own location)
IG_SESSION_FILE=

# ── Tuning ───────────────────────────────────────────────────────────────────
EXTRACTION_MODEL=claude-opus-5
MAX_COMMENTS=100
KEYFRAMES=6
