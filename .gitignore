# secrets — never commit
.env
*.session
session-*

# instaloader session files
.instaloader-*

# downloaded media
downloads/
seed/
out/
*.mp4
*.wav
*.jpg
*.jpeg
*.png
*.json.xz

# ...but artwork under public/ is source, not scraped media. Without this the
# category tiles are silently dropped from commits and 404 on a fresh clone.
!public/**/*.jpg
!public/**/*.jpeg
!public/**/*.png

# python
__pycache__/
*.py[cod]
.venv/
venv/
.v/
*.egg-info/

# editors / os
.vscode/
.idea/
.DS_Store

# node / next
node_modules/
.next/
next-env.d.ts
*.tsbuildinfo

# processed output (regenerable from the source reels)
out/
propmt.txt
